int branch_loop(int x) {
  int i = 0;
  int a = x;
  int b = 3;
  int c = 5;
  while (i < 4) {
    if (i % 7 == 0) {
      a = a + i;
    } else {
      b = b + a;
    }
    c = c + a + b;
    i = i + 1;
  }
  return a + b + c + i;
}

int nested_loop() {
  int i = 0;
  int j = 0;
  int sum = 0;
  while (i < 5) {
    j = 0;
    while (j < i + 4) {
      sum = sum + i + j;
      j = j + 1;
    }
    i = i + 1;
  }
  return sum + i + j + 1;
}

int main() {
  return branch_loop(2) + nested_loop();
}
