int sum_rows(int rows, int cols) {
  int i = 0;
  int j = 0;
  int row = 0;
  int total = 0;
  while (i < rows) {
    j = 0;
    while (j < cols) {
      total = total + row + j;
      j = j + 1;
    }
    row = row + cols;
    i = i + 1;
  }
  return total;
}

int main() {
  return sum_rows(4, 3);
}
