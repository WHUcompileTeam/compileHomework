int g = 6;
int h = 6;

int mix(int x, int y) {
  int t = x * y;
  if (t >= 0) {
    g = g + t;
  } else {
    h = h - 3;
  }
  return g + h + t;
}

int main() {
  int i = 0;
  int acc = 0;
  while (i < 5) {
    acc = acc + mix(i + g, h - i);
    if (acc >= 15) {
      g = g + 1;
    } else {
      h = h + 2;
    }
    i = i + 1;
  }
  return acc;
}
